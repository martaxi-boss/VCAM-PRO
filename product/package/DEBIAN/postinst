#!/bin/sh
set +e

ROOT_PREFIX="${VCAM_TEST_ROOT_PREFIX:-/var/jb}"
VCAM_ROOT="$ROOT_PREFIX/var/mobile/Library/VCAMPro"
VCAM_MEDIA="$VCAM_ROOT/Media"

mkdir -p "$VCAM_MEDIA" 2>/dev/null || true
chown mobile:mobile "$VCAM_ROOT" "$VCAM_MEDIA" 2>/dev/null || true
chmod 0755 "$VCAM_ROOT" "$VCAM_MEDIA" 2>/dev/null || true

exit 0
