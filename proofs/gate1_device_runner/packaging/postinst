#!/bin/sh
set -eu

COORDINATOR="/var/jb/usr/libexec/vcampro-gate1-coordinator"
VIEWER="/var/jb/Applications/VCAMProGate1.app"

if [ "${1:-}" = "configure" ]; then
    if [ -x "$COORDINATOR" ]; then
        "$COORDINATOR" || true
    fi
    if [ -x /var/jb/usr/bin/uicache ]; then
        /var/jb/usr/bin/uicache -p "$VIEWER" >/dev/null 2>&1 || true
    fi
fi

exit 0
