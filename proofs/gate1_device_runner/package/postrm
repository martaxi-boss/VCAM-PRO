#!/bin/sh
set +e

case "${1:-}" in
    remove|purge)
        if [ -x /var/jb/usr/bin/uicache ]; then
            /var/jb/usr/bin/uicache -u com.vcampro.gate1viewer >/dev/null 2>&1 || true
        elif [ -x /usr/bin/uicache ]; then
            /usr/bin/uicache -u com.vcampro.gate1viewer >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
