#!/bin/sh
set +e

APP=/var/jb/Applications/VCAMProGate1.app
HANDOFF_PLIST=/var/jb/Library/LaunchDaemons/com.vcampro.gate1.handoff.plist

rm -f /var/tmp/VCAM_PRO_GATE1_REQUEST.txt >/dev/null 2>&1 || true
rm -f /var/tmp/VCAM_PRO_GATE1_WITNESS.txt >/dev/null 2>&1 || true

if [ -x /var/jb/bin/launchctl ]; then
    /var/jb/bin/launchctl bootstrap system "$HANDOFF_PLIST" >/dev/null 2>&1 || true
elif [ -x /bin/launchctl ]; then
    /bin/launchctl bootstrap system "$HANDOFF_PLIST" >/dev/null 2>&1 || true
fi

if [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -p "$APP" >/dev/null 2>&1 || true
elif [ -x /usr/bin/uicache ]; then
    /usr/bin/uicache -p "$APP" >/dev/null 2>&1 || true
fi

exit 0
